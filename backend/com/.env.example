# ========== 复制此文件为 .env 并填入真实值 ==========
# cp .env.example .env

# 数据库密码
DB_PASSWORD=your-db-password

# JWT 密钥（至少32位，生产环境务必修改）
JWT_SECRET=comic-secret-key-please-change-in-production

# 火山引擎 Ark SDK（Seedream 图片生成 / Seedance 视频生成）
ARK_API_KEY=your-ark-api-key

# Vidu 视频生成
VIDU_API_KEY=your-vidu-api-key

# DeepSeek API（文本/剧本生成）
DEEPSEEK_API_KEY=your-deepseek-api-key

# Sora2 视频生成
SORA2_API_KEY=your-sora2-api-key
SORA2_BASE_URL=https://api.openai.com/v1
SORA2_MODEL=sora

# Nanobanana 视频生成
NANOBANANA_API_KEY=your-nanobanana-api-key
NANOBANANA_BASE_URL=https://api.nanobanana.com
NANOBANANA_MODEL=

# 阿里云 OSS（图片/文件存储）
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret